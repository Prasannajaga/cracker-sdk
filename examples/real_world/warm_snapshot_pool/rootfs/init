#!/bin/sh
set -eu

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

echo "starting python counter" > /dev/console

/var/lang/bin/python3 /counter.py > /dev/console 2>&1

echo "counter process exited" > /dev/console

sync
poweroff -f || reboot -f || halt -f

while true; do
  sleep 1
done