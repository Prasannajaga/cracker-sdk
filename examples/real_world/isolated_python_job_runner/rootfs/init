#!/bin/sh
set -eu

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true

echo "starting isolated python job runner agent" > /dev/console

/usr/bin/python3 /agent.py > /dev/console 2>&1

echo "agent exited" > /dev/console

sync
poweroff -f || reboot -f || halt -f

while true; do
  sleep 1
done
