#!/bin/sh
set -eu

log() {
  echo "$1" >/dev/console 2>/dev/null || true
}

dump() {
  "$@" >/dev/console 2>&1 || true
}

show_entropy() {
  if [ -r /proc/sys/kernel/random/entropy_avail ]; then
    log "guest entropy available: $(cat /proc/sys/kernel/random/entropy_avail)"
  fi
}

mkdir -p /dev
mknod /dev/console c 5 1 2>/dev/null || true

log "ssh sandbox init started"

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true

mknod /dev/console c 5 1 2>/dev/null || true
mknod /dev/null c 1 3 2>/dev/null || true
mknod /dev/zero c 1 5 2>/dev/null || true
mknod /dev/random c 1 8 2>/dev/null || true
mknod /dev/urandom c 1 9 2>/dev/null || true

log "mounted guest pseudo filesystems"

ip link set lo up 2>/dev/null || true
ip addr add 172.16.0.2/24 dev eth0 2>/dev/null || true
ip link set eth0 up

log "configured eth0 as 172.16.0.2/24"
dump ip addr show
dump ip route show

SSHD_LISTEN_TIMEOUT=60

mkdir -p /run/sshd /root/.ssh
chmod 700 /root/.ssh
chmod 600 /root/.ssh/authorized_keys 2>/dev/null || true

if [ ! -s /etc/ssh/ssh_host_ed25519_key ]; then
  log "missing ssh host keys; rebuild rootfs so Dockerfile can run ssh-keygen -A"
  sleep 3600
fi

show_entropy
if [ -x /usr/local/sbin/seed-entropy ]; then
  dump /usr/local/sbin/seed-entropy
  show_entropy
fi

log "starting sshd on 172.16.0.2:22"
/usr/sbin/sshd \
  -D \
  -e \
  -f /etc/ssh/sshd_config \
  -o AddressFamily=inet \
  -o ListenAddress=0.0.0.0 \
  -o LogLevel=DEBUG \
  >/dev/console 2>&1 &
sshd_pid="$!"

attempt=1
while [ "$attempt" -le "$SSHD_LISTEN_TIMEOUT" ]; do
  if ! kill -0 "$sshd_pid" 2>/dev/null; then
    log "sshd exited before listener check"
    break
  fi

  if ss -lnt 2>/dev/null | grep -q ':22 '; then
    log "sshd is listening on port 22 with pid ${sshd_pid}"
    dump ss -lntp
    break
  fi

  sleep 1
  attempt=$((attempt + 1))
done

if kill -0 "$sshd_pid" 2>/dev/null && ! ss -lnt 2>/dev/null | grep -q ':22 '; then
  log "sshd is running but did not open port 22 within ${SSHD_LISTEN_TIMEOUT} seconds"
  dump ps
  dump ss -lntp
fi

set +e
wait "$sshd_pid"
status="$?"
set -e
log "sshd exited with status ${status}"
sleep 3600
